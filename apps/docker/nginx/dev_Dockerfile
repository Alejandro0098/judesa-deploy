FROM nginx:stable-alpine

RUN mkdir -p /app/docker/nginx/ssl

RUN ls -l /app/docker/nginx

RUN rm /etc/nginx/conf.d/default.conf && \
    chown -R root:root /app/docker/nginx/ssl && \
    chmod -R 600 /app/docker/nginx/ssl

COPY ./apps/docker/nginx/nginx.conf /etc/nginx/conf.d/nginx.conf
COPY ./apps/docker/nginx/ssl /etc/nginx/ssl

EXPOSE 80:443

CMD ["nginx-debug", "-g", "daemon off;"]